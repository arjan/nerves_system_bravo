# erlinit configuration for the HTC Desire (bravo)
#
# The stock 2.6.37 kernel has no fbcon, so there is no console on the screen.
# Use the USB RNDIS network (usb0) and ssh to get at a shell.
-c ttyMSM0
--warn-unused-tty

# -s is --alternate-exec: erlinit runs this *instead of* erlexec and passes
# erlexec + its arguments to it, so it must end with exec "$@".
# It populates /dev (no devtmpfs on this kernel) and enables USB networking.
-s /usr/libexec/bravo-init

-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Application data: the "cache" NAND partition (mtd4, 40 MB). yaffs2 formats
# an erased partition on first mount.
-m /dev/mtdblock4:/root:yaffs2:nodev:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m cpu:/sys/fs/cgroup/cpu:cgroup:nodev,noexec,nosuid:cpu

-r /srv/erlang
-n nerves-bravo
--boot shoehorn
