#!/bin/sh
# udhcpc event script for wlan0. The stock /usr/share/udhcpc/default.script hangs
# on this image (mktemp gives an empty name, then `cat $TMPFILE` reads stdin
# forever), so udhcpc never configures the interface. This one only sets the
# address and the default route; DNS is not needed (Home Assistant is reached by IP)
# and not touching /etc/resolv.conf avoids rewriting NAND on every lease renewal.
case "$1" in
	deconfig)
		/sbin/ifconfig "$interface" 0.0.0.0 up
		;;
	bound|renew)
		/sbin/ifconfig "$interface" "$ip" ${broadcast:+broadcast $broadcast} ${subnet:+netmask $subnet}
		if [ -n "$router" ]; then
			while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
			for gw in $router; do
				route add default gw "$gw" dev "$interface"
			done
		fi
		;;
esac
exit 0
