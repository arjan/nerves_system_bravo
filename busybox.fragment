CONFIG_ASH_GETOPTS=y
CONFIG_BASENAME=y
CONFIG_CUT=y
CONFIG_EXPR=y
CONFIG_EXPR_MATH_SUPPORT_64=y
CONFIG_SED=y
CONFIG_SLEEP=y
# The stock 2.6.37 kernel has no devtmpfs, so /dev is populated by mdev
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_INSMOD=y
CONFIG_LSMOD=y
CONFIG_MODPROBE_SMALL=y
CONFIG_MKNOD=y
CONFIG_CHROOT=y
